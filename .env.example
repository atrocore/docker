# Deployment mode: pick one override file
#   docker-compose.local.yaml | docker-compose.traefik.yaml | docker-compose.traefik-ssl.yaml
COMPOSE_FILE=docker-compose.yaml:docker-compose.traefik.yaml

# Host port for the local mode
LOCAL_PORT=8080

# WEB container variables
SKELETON_VARIANT=pim-no-demo
PRODUCTION_DOMAIN=localhost
PRODUCTION_STABILITY=stable
TESTING_DOMAIN=
TESTING_STABILITY=rc

# base or pdf
BUILD_VARIANT=base


# Postgres container variables
POSTGRES_PASSWORD=
POSTGRES_PIM_USER=
POSTGRES_PIM_PASSWORD=
POSTGRES_PIM_DB=atrocore
POSTGRES_PIM_DB_TEST=

# Proxy configuration (used by traefik / traefik-ssl profiles)
LETS_ENCRYPT_EMAIL=
PROXY_PRODUCTION_ROUTER=atrocore_prod
PROXY_TESTING_ROUTER=